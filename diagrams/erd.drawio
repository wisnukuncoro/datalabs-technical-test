        <mxCell id="n2" value="&lt;table style='width:100%;border-collapse:collapse;font-family:Helvetica;font-size:12px;'&gt;&lt;tr&gt;&lt;td style='background:#833c0c;color:#ffffff;font-weight:bold;padding:6px;text-align:center;'&gt;fact_sales (grain: 1 row per transaction line item)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;transaction_item_id (PK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;transaction_id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;customer_key (FK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;product_key (FK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;campaign_key (FK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;date_key (FK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;sale_date  -- partition key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;quantity&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;unit_price&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;line_amount&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td align='left' style='padding:2px 6px;border-top:1px solid #d0d0d0;'&gt;transaction_total_amount&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a8a8a;verticalAlign=top;align=left;spacing=0;fontSize=12;" vertex="1" parent="1">
