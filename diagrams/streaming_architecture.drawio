<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="Streaming_Pipeline_Architecture" name="Streaming Pipeline Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="Dummy Transaction Producer&#10;(Python, src/streaming/producer.py)&#10;emits JSON events with event_time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Kafka-compatible Broker&#10;(Redpanda, topic: transactions.raw)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="190" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Stream Consumer&#10;(Python, src/streaming/consumer.py)&#10;tumbling 1-min event-time window&#10;+ watermark for late arrivals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Console Output&#10;(per-window count + total amount)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="120" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="BigQuery Sink&#10;streaming.transaction_window_counts&#10;partitioned by DATE(window_start)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1100" y="230" width="220" height="80" as="geometry" />
