        <mxCell id="n10" value="optional, if configured" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="n4" target="n6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Real-Time Pipeline: Producer -&gt; Kafka -&gt; Tumbling-Window Aggregator -&gt; Console / BigQuery" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1">
