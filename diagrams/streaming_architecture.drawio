        <mxCell id="n8" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;elbow=vertical;strokeColor=#666666;fontSize=12;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
